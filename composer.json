{
  "name": "local/guild-log-overview",
  "description": "Simple PHP guild log upload and statistics overview",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "twig/twig": "^3.30"
  },
  "autoload": {
    "psr-4": {
      "LogConv\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}