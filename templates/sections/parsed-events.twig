<section class="card parsed-events-card" aria-labelledby="parsed-events-title">
    <div class="section-heading">
        <h2 id="parsed-events-title">{{ text.sections.events|raw }}</h2>
        <p>{{ text.sections.events_hint }}</p>
    </div>

    <div class="table-wrap" tabindex="0" aria-label="{{ text.aria.events_table }}">
        <table>
            <caption class="visually-hidden">{{ text.captions.events_table }}</caption>
            <thead>
            <tr>
                <th scope="col">{{ text.table.number }}</th>
                <th scope="col">{{ text.table.killer }}</th>
                <th scope="col">{{ text.table.killer_guild }}</th>
                <th scope="col">{{ text.table.victim }}</th>
                <th scope="col">{{ text.table.victim_guild }}</th>
                <th scope="col">{{ text.table.points }}</th>
            </tr>
            </thead>

            <tbody data-expandable-table data-initial-visible="10">
            {% for event in result.events %}
                <tr{% if loop.index > 10 %} class="is-extra-row" hidden{% endif %}>
                    <td>{{ loop.index|fmt }}</td>
                    <td>
                        <button type="button" class="link-button js-detail" data-detail-target="{{ detail_key('player', event.killer_guild, event.killer_name) }}" aria-label="{{ text.aria.show_killer }} {{ event.killer_name }}">
                            {{ event.killer_name }}
                        </button>
                    </td>
                    <td>
                        <button type="button" class="badge badge-button js-detail" data-detail-target="{{ guild_detail_key(event.killer_guild) }}" aria-label="{{ text.aria.show_killer_guild }} {{ event.killer_guild }}">
                            &#x2694;&#xFE0F; {{ event.killer_guild }}
                        </button>
                    </td>
                    <td>
                        <button type="button" class="link-button js-detail" data-detail-target="{{ detail_key('player', event.victim_guild, event.victim_name) }}" aria-label="{{ text.aria.show_victim }} {{ event.victim_name }}">
                            {{ event.victim_name }}
                        </button>
                    </td>
                    <td>
                        <button type="button" class="badge badge-button muted js-detail" data-detail-target="{{ guild_detail_key(event.victim_guild) }}" aria-label="{{ text.aria.show_victim_guild }} {{ event.victim_guild }}">
                            &#x1F6E1;&#xFE0F; {{ event.victim_guild }}
                        </button>
                    </td>
                    <td><strong>{{ event.points|fmt }}</strong></td>
                </tr>
            {% endfor %}
            </tbody>

            {% if result.events|length > 10 %}
                <tfoot>
                <tr class="table-expand-row">
                    <td colspan="6">
                        <div class="table-expand-inline">
                            <span class="muted-text table-expand-hint">
                                Showing first 10 of {{ result.events|length|fmt }} parsed events.
                            </span>

                            <button
                                type="button"
                                class="primary-button table-expand-button"
                                data-expand-table-button
                                data-expand-label="Show all {{ result.events|length|fmt }} events"
                                data-collapse-label="Show only first 10 events"
                                aria-expanded="false"
                            >
                                Show all {{ result.events|length|fmt }} events
                            </button>
                        </div>
                    </td>
                </tr>
                </tfoot>
            {% endif %}
        </table>
    </div>
</section>