<section class="card" aria-labelledby="guild-matchups-title">
    <div class="section-heading">
        <h2 id="guild-matchups-title">{{ text.sections.matchups|raw }}</h2>
        <p>{{ text.sections.matchups_hint }}</p>
    </div>

    <div class="table-wrap" tabindex="0" aria-label="{{ text.aria.matchups_table }}">
        <table>
            <caption class="visually-hidden">{{ text.captions.matchups_table }}</caption>
            <thead>
            <tr>
                <th scope="col">{{ text.table.attacking_guild }}</th>
                <th scope="col">{{ text.table.victim_guild }}</th>
                <th scope="col">{{ text.table.kills }}</th>
                <th scope="col">{{ text.table.points }}</th>
            </tr>
            </thead>
            <tbody>
            {% for matchup in result.matchups %}
                <tr>
                    <td>
                        <button type="button" class="badge badge-button js-detail" data-detail-target="{{ guild_detail_key(matchup.killer_guild) }}" aria-label="{{ text.aria.show_attacking_guild }} {{ matchup.killer_guild }}">
                            &#x2694;&#xFE0F; {{ matchup.killer_guild }}
                        </button>
                    </td>
                    <td>
                        <button type="button" class="badge badge-button muted js-detail" data-detail-target="{{ guild_detail_key(matchup.victim_guild) }}" aria-label="{{ text.aria.show_victim_guild }} {{ matchup.victim_guild }}">
                            &#x1F6E1;&#xFE0F; {{ matchup.victim_guild }}
                        </button>
                    </td>
                    <td>{{ matchup.kills|fmt }}</td>
                    <td><strong>{{ matchup.points|fmt }}</strong></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>