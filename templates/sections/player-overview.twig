<section class="card" aria-labelledby="player-overview-title">
    <div class="section-heading">
        <h2 id="player-overview-title">{{ text.sections.players|raw }}</h2>
        <p>{{ text.sections.players_hint }}</p>
    </div>

    <div class="table-wrap" tabindex="0" aria-label="{{ text.aria.player_table }}">
        <table>
            <caption class="visually-hidden">{{ text.captions.player_table }}</caption>
            <thead>
            <tr>
                <th scope="col">{{ text.table.player }}</th>
                <th scope="col">{{ text.table.guild }}</th>
                <th scope="col">{{ text.table.kills }}</th>
                <th scope="col">{{ text.table.deaths }}</th>
                <th scope="col">{{ text.table.kd }}</th>
                <th scope="col">{{ text.table.points }}</th>
            </tr>
            </thead>
            <tbody>
            {% for player in result.players %}
                <tr>
                    <td>
                        <button type="button" class="link-button js-detail" data-detail-target="{{ detail_key('player', player.guild, player.name) }}" aria-label="{{ text.aria.show_player }} {{ player.name }}">
                            {{ player.name }}
                        </button>
                    </td>
                    <td>
                        <button type="button" class="badge badge-button js-detail" data-detail-target="{{ guild_detail_key(player.guild) }}" aria-label="{{ text.aria.show_guild }} {{ player.guild }}">
                            &#x1F6E1;&#xFE0F; {{ player.guild }}
                        </button>
                    </td>
                    <td>{{ player.kills|fmt }}</td>
                    <td>{{ player.deaths|fmt }}</td>
                    <td>{{ player.kd_ratio }}</td>
                    <td><strong>{{ player.points|fmt }}</strong></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>